# App
APP_NAME=VideoMachine
APP_VERSION=1.0.0
SECRET_KEY=your-super-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database
DATABASE_URL=sqlite:///./videomachine.db
# For production: postgresql://user:password@localhost/videomachine

# Redis
REDIS_URL=redis://localhost:6379

# AI APIs
OPENAI_API_KEY=your-openai-api-key
ANTHROPIC_API_KEY=your-anthropic-api-key

# TTS
ELEVEN_LABS_API_KEY=your-elevenlabs-api-key

# Video/Media
PEXELS_API_KEY=your-pexels-api-key
PIXABAY_API_KEY=your-pixabay-api-key

# Storage
STORAGE_TYPE=local
# For S3: AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY, S3_BUCKET_NAME
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=videomachine-uploads
S3_REGION=us-east-1

# FedaPay
FEDAPAY_PUBLIC_KEY=your-fedapay-public-key
FEDAPAY_SECRET_KEY=your-fedapay-secret-key
FEDAPAY_ENV=sandbox

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Files
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=104857600
